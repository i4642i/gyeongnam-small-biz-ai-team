# ====================================================================
#  API 키를 여기에 채운 뒤 run.bat 을 실행하세요.
#
#  키를 비워 두어도 run.bat 은 실행되고 화면은 둘러볼 수 있지만,
#  상담소에서 의뢰해 보고서를 만들려면 LLM 키와 데이터 키가 있어야 합니다.
#
#  값을 바꾼 뒤에는 서버를 껐다 켜야 반영됩니다.
# ====================================================================

# ---- LLM 모델 ----
# 쓰려는 공급사의 키를 넣으세요. 키를 넣은 공급사만 고를 수 있고,
# 직원별 모델은 직원 소개 화면의 '모델' 탭에서 바꿉니다.

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Gemini (https://aistudio.google.com)
GEMINI_API_KEY=

# 실제 모델을 부른다(바꾸지 마세요)
LLM_MODE=live

# ---- 데이터 ----

# 네이버 뉴스 검색 — 화제가 된 동네를 찾는 데 씁니다
# https://developers.naver.com 에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 키를 네이버 클라우드(NCP) API HUB 에서 받았으면 ncp, developers.naver.com 에서 받았으면 비워 둡니다
NAVER_AUTH=

# 소상공인시장진흥공단 상가(상권)정보 — 업종·점포 수를 세는 데 씁니다
# https://www.data.go.kr 에서 활용 신청 후 발급
SEMAS_API_KEY=

# ---- 선택: 색인 장비(GPU) ----
# 기사·전문자료 검색에 쓰는 임베딩 계산을 GPU 장비(예: 젯슨)로 넘길 때 채웁니다.
# 비워 두면 이 PC 가 계산합니다(처음 한 번 모델 약 2GB 를 내려받습니다).
# 주소를 적어도 기본은 이 PC 로 계산합니다(주소는 보관만). 화면에서 [젯슨] 을 눌러야 젯슨으로 계산합니다.
# 실행 중에는 사무실 → 뉴스 수집 컴퓨터 화면에서도 바꿀 수 있습니다(화면에서 바꾼 값이 우선).
EMBED_REMOTE_URL=
EMBED_REMOTE_TOKEN=
# 장비에 리랭커(검색 순위 매기기)도 설치돼 있으면 1
EMBED_REMOTE_RERANK=1
